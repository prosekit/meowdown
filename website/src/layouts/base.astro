---
import { ThemeScript } from 'astro-theme-toggle/components'

import ReferrerHead from '../components/referrer-head.astro'

import '../styles/index.css'

interface Props {
  title: string
}

const { title } = Astro.props
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <ReferrerHead />
    <title>{title}</title>
    <ThemeScript />
  </head>
  <body>
    <slot />
  </body>
</html>
