{
  "name": "@meowdown/core",
  "type": "module",
  "version": "0.82.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/prosekit/meowdown",
    "directory": "packages/core"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./style.css": {
      "development": "./src/style.css",
      "default": "./dist/style.css"
    }
  },
  "files": [
    "./dist/**/*.js",
    "./dist/**/*.d.ts",
    "./dist/**/*.css"
  ],
  "scripts": {
    "build": "tsdown"
  },
  "dependencies": {
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@floating-ui/dom": "^1.8.0",
    "@lezer/highlight": "^1.2.5",
    "@meowdown/embed": "workspace:*",
    "@meowdown/markdown": "workspace:*",
    "@ocavue/utils": "^1.9.0",
    "@post-embed/exporter": "^0.5.0",
    "@post-embed/schema": "^0.5.2",
    "@post-embed/types": "^0.5.0",
    "@prosekit/core": "^0.13.4",
    "@prosekit/extensions": "^0.18.5",
    "@prosekit/pm": "^0.1.21",
    "@prosekit/web": "^0.10.0",
    "hast-util-from-dom": "^5.0.1",
    "hast-util-to-mdast": "^10.1.2",
    "katex": "^0.19.0",
    "lru.min": "^1.1.5",
    "mdast-util-to-markdown": "^2.2.1",
    "micromark-util-decode-string": "^2.0.1",
    "micromark-util-normalize-identifier": "^2.0.1",
    "prosemirror-enter-rules": "^0.1.6",
    "prosemirror-flat-list": "^0.7.3",
    "prosemirror-highlight": "^0.16.0",
    "rehype-remark": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-stringify": "^11.0.0",
    "unicode-by-name": "^0.2.0",
    "unified": "^11.0.5",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@meowdown/vitest": "workspace:*",
    "@ocavue/tsconfig": "^0.7.1",
    "@tsdown/css": "^0.23.3",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@vitest/browser-playwright": "^5.0.5",
    "dedent": "^1.7.2",
    "diffable-html-snapshot": "^0.4.0",
    "tsdown": "^0.23.3",
    "vitest": "^5.0.5"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.js",
      "./style.css": "./dist/style.css"
    },
    "access": "public"
  }
}
